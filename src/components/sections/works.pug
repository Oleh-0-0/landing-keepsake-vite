section#works.section(aria-labelledby='works-title')
  .container
    +section-title('Our awesome works', 'works-title')
    //- фільтр через :checked ~ ; радіокнопки й чипси генеруються з масиву
    .filter
      each cat, i in categories
        input.filter__input(
          type='radio',
          name='filter',
          id=`f-${cat}`,
          value=cat,
          checked=i === 0
        )
        label.chip(for=`f-${cat}`) #{ cat }
      ul.works-grid
        each work in works
          li.works-grid__item(data-category=work.category)
            +work-card(work)
    .works__more
      +btn('Load more works', '#works', 'secondary')
