//- +picture('work-01', 'alt', { sizes, lazy, cls, w, h })
mixin picture(name, alt, opts = {})
  - const { sizes = '100vw', lazy = true, cls = '', w = 800, h = 632 } = opts;
  - const base = `/assets/${name}`;
  picture
    each fmt in ['avif', 'webp']
      source(
        type=`image/${fmt}`,
        srcset=`${base}-400.${fmt} 400w, ${base}-800.${fmt} 800w`,
        sizes=sizes
      )
    img(
      class=cls,
      src=`${base}-800.jpg`,
      alt=alt,
      width=w,
      height=h,
      decoding='async',
      loading=lazy ? 'lazy' : false,
      fetchpriority=lazy ? false : 'high'
    )
