footer#contact.footer
  .container
    .footer__top
      each col in footerColumns
        nav.footer__col(aria-label=col.title)
          h2.footer__title #{ col.title }
          ul
            each link in col.links
              li
                a.footer__link(href='#') #{ link }
      form.subscribe(novalidate)
        label.subscribe__label(for='email') Subscribe
        input#email.subscribe__input(
          type='email',
          required,
          placeholder='Your email',
          aria-describedby='email-error'
        )
        p#email-error.subscribe__error Please enter a valid email
        label.subscribe__consent
          input(type='checkbox', required)
          |
          | I agree to the privacy policy
        +btn('Subscribe', false)
    .footer__bottom
      p.footer__copy © 2026 Keepsake
      ul.socials
        each s in socials
          li
            a.socials__link(href='#', aria-label=s.label)
              +icon('brand')
