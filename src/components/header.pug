header.header
  .container.header__inner
    a.logo(href='#top', aria-label='Keepsake home')
      span.logo__mark K
      span.logo__text Keepsake
    input#nav-toggle.header__toggle(type='checkbox', aria-controls='menu')
    label.header__burger(for='nav-toggle', aria-label='Toggle menu')
      +icon('menu')
      +icon('close')
    nav#menu.nav(aria-label='Main')
      ul.nav__list
        each item in nav
          li.nav__item
            a.nav__link(
              href=item.href,
              class={ 'nav__link--active': item.active },
              aria-current=item.active ? 'page' : false
            ) #{ item.label }
      a.header__fav(href='#', aria-label='Favourites')
        +icon('heart')
